# Optional: deploy as root-owned file and point the install script at it
# (default path: /Library/Managed Preferences/ai.neuraltrust.trustguard-claude-code.env)
#
# Kandji: separate Custom Script / file drop, or paste values into the
# install script CONFIG block instead.

TRUSTGUARD_DATA_URL=https://data.example.neuraltrust.ai
TRUSTGUARD_API_KEY=tgk_YOUR_ORG_CLAUDE_CODE_COLLECTOR_KEY
TRUSTGUARD_FAIL_MODE=closed

# Optional:
# TRUSTGUARD_CLAUDE_CODE_VERSION=0.1.12
# TRUSTGUARD_BINARY_SHA256=
# TRUSTGUARD_TIMEOUT_MS=5000
# TRUSTGUARD_TRANSFORM_ACTION=ask

# Claude Code managed settings (plugin + TrustGate MCP URL) — same install script:
# TRUSTGUARD_DEPLOY_CLAUDE_MANAGED_SETTINGS=1
# TRUSTGATE_MCP_URL=https://host/consumer-slug/mcp
